<launch>
	<arg name="world" default="$(find-pkg-share puzzlebot_gazebo)/worlds/maze.world"/>
	<arg name="use_sim_time" default="true"/>
	<arg name="rviz" default="false"/>
	<arg name="spawn_robot" default="true"/>

	<include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.xml">
		<arg name="gz_args" value="-r $(var world)"/>
	</include>

	<node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
		<param name="config_file" value="$(find-pkg-share puzzlebot_gazebo)/config/gazebo_bridge.yaml"/>
	</node>

	<include file="$(find-pkg-share puzzlebot_description)/launch/puzzlebot_description.launch.xml">
		<arg name="use_sim_time" value="$(var use_sim_time)"/>
		<arg name="rviz" value="$(var rviz)"/>
		<arg name="gazebo" value="false"/>
	</include>

	<node
		pkg="ros_gz_sim"
		exec="create"
		output="screen"
		if="$(var spawn_robot)"
		args="-name puzzlebot -topic robot_description"/>
</launch>
