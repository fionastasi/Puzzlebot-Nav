<launch>
  <arg name="world" default="$(find-pkg-share puzzlebot_gazebo)/worlds/maze.world"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="spawn_robot" default="true"/>
  <arg name="slam_params_file" default="$(find-pkg-share puzzlebot_navigation2)/config/slam_toolbox.yaml"/>

  <include file="$(find-pkg-share puzzlebot_gazebo)/launch/puzzlebot_gazebo.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="spawn_robot" value="$(var spawn_robot)"/>
  </include>

  <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <param from="$(var slam_params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>