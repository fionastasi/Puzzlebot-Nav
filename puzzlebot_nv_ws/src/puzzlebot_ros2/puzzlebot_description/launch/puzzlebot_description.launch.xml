<launch>
    <arg name="rviz" default="false" />
    <arg name="gazebo" default="false" />
    <arg name="joint_gui" default="false" />
    <arg name="use_sim_time" default="false" />

    <let name="puzzlebot_xacro_path" value="$(find-pkg-share puzzlebot_description)/urdf/puzzlebot.xacro" />
    <let name="rviz_config_path" value="$(find-pkg-share puzzlebot_description)/rviz/puzzlebot_description.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var puzzlebot_xacro_path)')" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" if="$(var rviz)" args="-d $(var rviz_config_path)">
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    

    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" output="screen" if="$(var joint_gui)" />
</launch>