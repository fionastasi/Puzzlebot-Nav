<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="puzzlebot_sensors" params="lidar_x:=0.0 lidar_z:=0.055 lidar_mass:=0.05 mesh_scale:=1.0">
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0.021" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://puzzlebot_description/meshes/RPLidar.stl"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}" />
        </geometry>
        <material name="white">
          <color rgba="0.9 0.9 0.9 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.021" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://puzzlebot_description/meshes/RPLidar.stl"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}" />
        </geometry>
      </collision>
      <xacro:box_inertial mass="${lidar_mass}" x="0.05" y="0.05" z="0.03" />
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_link" />
      <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0" />
    </joint>

    <gazebo reference="lidar_link">
      <sensor name="lidar_sensor" type="gpu_lidar">
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <ray>
              <scan>
                  <horizontal>
                      <samples>360</samples>
                      <min_angle>-3.14159</min_angle>
                      <max_angle>3.14159</max_angle>
                  </horizontal>
              </scan>
              <range>
                  <min>0.15</min>
                  <max>12.0</max>
              </range>
          </ray>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>