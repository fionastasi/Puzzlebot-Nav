<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="puzzlebot_sensors" params="lidar_x:=0.06 lidar_z:=0.055 lidar_mass:=0.05">
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.05 0.05 0.03" />
        </geometry>
        <material name="white">
          <color rgba="0.9 0.9 0.9 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.05 0.05 0.03" />
        </geometry>
      </collision>
      <xacro:box_inertial mass="${lidar_mass}" x="0.05" y="0.05" z="0.03" />
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_link" />
      <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0" />
    </joint>
  </xacro:macro>
</robot>