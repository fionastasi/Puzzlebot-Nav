<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    puzzlebot_sensors — LiDAR mount and laser_frame definition.

    Defines the physical TF chain:
      base_link -> lidar_base_link -> laser_frame

    The <gazebo> block below is SIMULATION ONLY — it configures the
    gpu_lidar sensor plugin for Gazebo. On the real robot this block
    is ignored; the RPLidar A1 driver (rplidar_ros) publishes /scan
    directly to the laser_frame defined by the joints above.
  -->
  <xacro:macro name="puzzlebot_sensors"
               params="lidar_x:=0.0 lidar_z:=0.055 lidar_mass:=0.05 mesh_scale:=1">

    <link name="lidar_base_link" />

    <joint name="lidar_base_joint" type="fixed">
      <parent link="base_link" />
      <child link="lidar_base_link" />
      <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0" />
    </joint>

    <link name="laser_frame">
      <visual>
        <origin xyz="0 0 0.021" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://puzzlebot_description/meshes/RPLidar.stl"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}" />
        </geometry>
        <material name="white">
          <color rgba="0.9 0.9 0.9 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.021" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://puzzlebot_description/meshes/RPLidar.stl"
                scale="${mesh_scale} ${mesh_scale} ${mesh_scale}" />
        </geometry>
      </collision>
      <xacro:box_inertial mass="${lidar_mass}" x="0.05" y="0.05" z="0.03" />
    </link>

    <joint name="laser_frame_joint" type="fixed">
      <parent link="lidar_base_link" />
      <child link="laser_frame" />
      <origin xyz="0 0 0.021" rpy="0 0 0" />
    </joint>

    <!-- SIMULATION ONLY — Gazebo gpu_lidar sensor plugin.
         Not loaded when robot_state_publisher uses puzzlebot.urdf.xacro directly. -->
    <gazebo reference="laser_frame">
      <sensor name="lidar_sensor" type="gpu_lidar">
        <topic>scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
          </range>
        </ray>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>