<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find-pkg-share puzzlebot_description)/urdf/macros.xacro" />
  <xacro:include filename="$(find-pkg-share puzzlebot_description)/urdf/robot_base.xacro" />
  <xacro:include filename="$(find-pkg-share puzzlebot_description)/urdf/wheels.xacro" />
  <xacro:include filename="$(find-pkg-share puzzlebot_description)/urdf/sensors.xacro" />

  <xacro:robot_base />
  <xacro:puzzlebot_wheels />
  <xacro:puzzlebot_sensors />
</robot>