<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  
  <xacro:macro name="box_inertial" params="mass x y z">
      <inertia
        ixx="${mass/12.0 * (y * y + z * z)}" ixy="0.0" ixz="0.0"
        iyy="${mass/12.0 * (x * x + z * z)}" iyz="0.0"
        izz="${mass/12.0 * (x * x + y * y)}" />
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="radius height mass">
      <inertia
        ixx="${(mass/12.0) * (3.0 * (radius * radius) + height * height)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0) * (3.0 * (radius * radius) + height * height)}" iyz="0.0"
        izz="${(mass/2.0) * (radius * radius)}" />
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
      <inertia
        ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * radius * radius}" iyz="0.0"
        izz="${0.4 * mass * radius * radius}" />
  </xacro:macro>

  <xacro:macro name="cylindrical_tube_inertial" params="r1 r2 height mass">
      <inertia
        ixx="${(mass/12.0) * (3.0 * (r1 * r1 + r2 * r2) + height * height)}" ixy="0.0" ixz="0.0"
        iyy="${(mass/12.0) * (3.0 * (r1 * r1 + r2 * r2) + height * height)}" iyz="0.0"
        izz="${(mass/2.0) * (r1 * r1 + r2 * r2)}" />
  </xacro:macro>

</robot>