<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>puzzlebot_real_robot</name>
  <version>0.0.0</version>
  <description>Hardware bringup for the physical Puzzlebot. Replaces puzzlebot_gazebo
  in the execution flow by starting real drivers (micro-ROS, RPLidar, odometry)
  and connecting them to the Nav2 stack.</description>
  <maintainer email="stasifiona@gmail.com">fiona</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot description (URDF, TF tree via robot_state_publisher) -->
  <exec_depend>puzzlebot_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Nav2 and SLAM core launchers -->
  <exec_depend>puzzlebot_navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Real hardware drivers -->
  <exec_depend>rplidar_ros</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Python script dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>