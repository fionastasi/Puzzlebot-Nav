<launch>

  <!-- Robot state publishes the static TF tree -->
  <let name="urdf_path"
       value="$(find-pkg-share puzzlebot_description)/urdf/puzzlebot.urdf.xacro" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    <param name="use_sim_time" value="false" />
  </node>

  <!-- micro-ROS agent — bridges Jetson MCU with ROS 2 -->
  <include file="/home/puzzlebot/ros2_ws/install/puzzlebot_ros/share/puzzlebot_ros/micro_ros_agent.launch.py" />

  <!-- RPLidar A1 — publishes /scan -->
  <include file="$(find-pkg-share rplidar_ros)/launch/rplidar_a1_launch.py">
    <arg name="serial_port" value="/dev/ttyUSB1" /> <!-- Replace with actual port -->
    <arg name="frame_id" value="laser_frame" />
  </include>

  <!-- Localization node — reads /scan and /joint_states, publishes /odom -->
  <node pkg="puzzlebot_real_robot"
        exec="puzzlebot_localization.py"
        name="puzzlebot_localization"
        output="screen" />

  <!-- Joint state publisher — reads /odom, publishes /joint_states
       and broadcasts TF odom -> base_footprint -->
  <node pkg="puzzlebot_real_robot"
        exec="puzzlebot_joint_state_publisher.py"
        name="puzzlebot_joint_state_publisher"
        output="screen" />

  <!-- TF fix: connect laser_frame (URDF) with laser -->
  <!-- The URDF already defines laser_frame, so this static transform is unnecessary and can conflict with TF from robot_state_publisher. -->
  <!--<node pkg="tf2_ros" exec="static_transform_publisher"
        name="laser_tf_fix"
        args="0 0 0 0 0 0 laser_frame laser" />-->

</launch> 