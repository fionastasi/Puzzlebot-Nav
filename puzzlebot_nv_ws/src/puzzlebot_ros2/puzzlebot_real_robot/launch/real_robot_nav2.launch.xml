<launch>
  <arg name="map_path"
       default="$(find-pkg-share puzzlebot_real_robot)/maps/map_real.yaml" />
  <arg name="nav2_params_file"
       default="$(find-pkg-share puzzlebot_real_robot)/config/nav2_params_real.yaml" />
  <arg name="rviz_config_file"
       default="$(find-pkg-share puzzlebot_real_robot)/rviz/nav2.rviz" />
  <arg name="autostart" default="true" />

  <!-- Publish the robot's URDF to the ROS parameter server -->
  <let name="urdf_path"
       value="$(find-pkg-share puzzlebot_description)/urdf/puzzlebot.urdf.xacro" />
  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    <param name="use_sim_time" value="false" />
  </node>

  <!-- Nav2 stack: AMCL, costmaps, planners -->
  <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    <arg name="use_sim_time"  value="false" />
    <arg name="params_file" value="$(var nav2_params_file)" />
    <arg name="map" value="$(var map_path)" />
    <arg name="autostart" value="$(var autostart)" />
  </include>

  <!-- RViz for navigation visualization -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
        args="-d $(var rviz_config_file)">
    <param name="use_sim_time" value="false" />
  </node>

</launch>